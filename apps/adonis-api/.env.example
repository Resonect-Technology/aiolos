TZ=UTC
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# SQLite location for the Prisma client and CLI.
# Defaults to <app root>/tmp/db.sqlite3 when unset; production sets file:/data/db.sqlite3
# DATABASE_URL=

# API Security — required for the config write endpoints (X-API-Key header)
ADMIN_API_KEY=change_this_to_a_secure_key
