TZ=UTC
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# SQLite location for the Prisma client and CLI.
# Defaults to <app root>/tmp/db.sqlite3 when unset; production sets file:/data/db.sqlite3
# DATABASE_URL=

# Admin login password for the /admin dashboard section (POST /api/admin/session).
# Config write endpoints require the resulting session cookie.
ADMIN_PASSWORD=change_this_to_a_secure_password

# Station ingest auth (X-API-Key header on station POST routes: wind,
# temperature, diagnostics, ota-confirm). Leave unset to keep those routes
# open (local dev); set it to enforce. Must match STATION_API_KEY in
# firmware/secrets.ini.
# STATION_API_KEY=
