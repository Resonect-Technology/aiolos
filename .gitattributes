# Auto-detect text files and enforce LF line endings on all platforms
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf

# Config
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.prisma text eol=lf
*.tf text eol=lf
*.sql text eol=lf
*.ini text eol=lf
*.bru text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf

# Docker
Dockerfile* text eol=lf

# Lock files
pnpm-lock.yaml text eol=lf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.bin binary
*.elf binary
*.hex binary
*.zip binary
*.tar binary
*.gz binary
*.3mf binary
