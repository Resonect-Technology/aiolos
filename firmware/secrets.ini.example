[secrets]
; Network credentials
APN = "apn"
GPRS_USER = ""
GPRS_PASS = ""

; OTA settings
OTA_HOUR = 11
OTA_MINUTE = 0
OTA_DURATION = 15
OTA_SSID = "Aiolos-Weather-OTA"
OTA_PASSWORD = "weather-update"
OTA_UPDATE_PASSWORD = "firmware-update"
OTA_MIN_BATTERY_VOLTAGE = 3.6

; Power management
SLEEP_START_HOUR = 21
SLEEP_END_HOUR = 10

; Device identification
DEVICE_ID = "Aiolos"

; Server settings
; Use the reserved prod Elastic IP (a raw IP, NOT a hostname) — the SIM7000G
; modem's DNS is unreliable, so the station posts straight to the IP on :80.
; Get the value from `terraform output instance_public_ip` in infra/prod.
SERVER_HOST = "1.1.1.1"
SERVER_PORT = 80

; Station ingest auth - sent as X-API-Key on every request
STATION_API_KEY = "station-api-key"
